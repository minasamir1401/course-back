{
  "name": "lms-backend",
  "version": "1.0.0",
  "description": "LMS Backend API",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/scripts/start-production.js",
    "db:push": "npx prisma db push",
    "dev": "nodemon src/index.ts",
    "build": "npx prisma generate && tsc",
    "postinstall": "npx prisma generate",
    "test": "jest --config jest.config.cjs",
    "test:integration": "jest --config jest.config.cjs tests/quality/integration",
    "test:security": "jest --config jest.config.cjs tests/quality/security",
    "test:data": "jest --config jest.config.cjs tests/quality/data-integrity",
    "diagnose:lessons": "npx tsx src/scripts/diagnose-lesson-damage.ts",
    "diagnose:exam-access": "node src/scripts/diagnose-exam-access.js",
    "recover:lessons": "npx tsx src/scripts/recover-lesson-data.ts",
    "clean:marks": "node dist/scripts/clean-question-marks.js",
    "clean:arabic": "npx tsx scripts/clean-metadata-arabic.ts",
    "migrate:images": "npx tsx src/scripts/migrate-base64.ts",
    "delete:images": "npx ts-node src/scripts/delete-base64.ts",
    "convert:webp": "npx tsx src/scripts/convert-to-webp.ts",
    "migrate:webp": "npx tsx src/scripts/migrate-urls-to-webp.ts",
    "cleanup:report": "npx tsx src/scripts/cleanup-report.ts",
    "cleanup:delete": "node dist/scripts/cleanup-delete.js",
    "cleanup:duplicates": "npx tsx cleanup_duplicates_dokploy.ts",
    "clean:indexes": "npx tsx src/scripts/clean-invalid-indexes.ts",
    "test:system": "node ../project-support/scripts/system-regression-tests.js",
    "audit:data": "node ../project-support/scripts/data-integrity-audit.js"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@prisma/client": "^5.13.0",
    "@sentry/node": "^10.73.0",
    "@types/cookie-parser": "^1.4.10",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "pm2": "^5.4.0",
    "sharp": "^0.35.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "prisma": "^5.13.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
