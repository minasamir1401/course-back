# =============================================================
# Application Environment Variables - Example
# Copy this file to .env and fill in your actual values
# =============================================================

# -------------------------------------------------------------
# 1. رابط الـ API الخاص بالباك إند (يجب أن يحتوي على https:// ومسار /api)
# IMPORTANT: Must include the protocol (https://) and /api at the end
# Example for production: https://api.klevro.tech/api
# Example for local dev:  http://localhost:5000/api
# -------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://api.your-domain.com/api"

# -------------------------------------------------------------
# Backend security and database configuration
# Both values must be set in every deployment. Never use sample values.
# -------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"
JWT_SECRET="generate-a-unique-random-secret-with-at-least-32-characters"
SUPER_ADMIN_INITIAL_PASSWORD="set-a-unique-initial-password-with-at-least-16-characters"

# -------------------------------------------------------------
# 2. رابط الباك إند الأساسي (بدون /api في النهاية)
# Used by next.config.ts to proxy API requests server-side (avoids CORS)
# Must include the protocol (https://)
# Example for production: https://api.klevro.tech
# Example for local dev:  http://localhost:5000
# -------------------------------------------------------------
BACKEND_ORIGIN="https://api.your-domain.com"

# -------------------------------------------------------------
# 2.1. رابط الباك إند الداخلي بين حاويات Docker إن وجد
# Optional: use this when the backend is only reachable on a Docker network
# Example for docker-compose: http://backend:5000
# -------------------------------------------------------------
INTERNAL_BACKEND_URL="http://backend:5000"

# -------------------------------------------------------------
# 2.5. رابط الباك إند الأساسي للواجهة الأمامية (متاح للمتصفح مباشرة)
# Used by the browser for direct file uploads (bypasses Next.js proxy to avoid size limits/aborts)
# Example for production: https://api.klevro.tech
# Example for local dev:  http://localhost:5000
# -------------------------------------------------------------
NEXT_PUBLIC_BACKEND_ORIGIN="https://api.your-domain.com"

# -------------------------------------------------------------
# 3. منفذ تشغيل تطبيق Next.js
# -------------------------------------------------------------
PORT=3000
NODE_ENV="production"
