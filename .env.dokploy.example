## Dokploy - Shared Environment Example
## Copy values into Dokploy Variables (Project/Service level)

# Backend
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
JWT_SECRET=change_this_to_a_long_random_secret
BACKEND_PORT=5000
# Disabled by default: cloud backup is optional and must never block the LMS.
ENABLE_CLOUD_BACKUP=false

# Frontend
# IMPORTANT:
# NEXT_PUBLIC_API_URL should include /api
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api
# BACKEND_ORIGIN should be base URL without /api
BACKEND_ORIGIN=https://api.your-domain.com
# Optional internal backend URL if frontend and backend share a Docker network
INTERNAL_BACKEND_URL=http://backend:5000
NEXT_PUBLIC_BACKEND_ORIGIN=https://api.your-domain.com
FRONTEND_PORT=3000
