generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id            String   @id @default(uuid())
  name          String
  subdomain     String?  @unique
  themeColor    String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  courses       Course[] @relation("CourseOwner")
  ownedExams    Exam[]   @relation("ExamOwner")
  users         User[]
  assignedExams Exam[]   @relation("ExamToSchool")
  assignedCourses Course[] @relation("CourseToSchool")
  classrooms    Classroom[]
  skillClusters SkillCluster[] @relation("SkillClusterOwner")
  examFolders   ExamFolder[]
  certificates Certificate[]
  competitions Competition[]
}

model User {
  id                 String              @id @default(uuid())
  name               String
  username           String              @unique
  email              String?             @unique
  password           String
  role               String              @default("STUDENT") // SUPER_ADMIN, SCHOOL_ADMIN, TEACHER, STUDENT, PARENT, SUPERVISOR
  
  // Profile Fields
  avatar             String?
  phone              String?
  status             String              @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  gender             String?             // MALE, FEMALE
  address            String?
  grade              String?
  specialization     String?
  
  // School Link
  schoolId           String?
  school             School?             @relation(fields: [schoolId], references: [id])
  
  // Classroom Link (for students)
  classroomId        String?
  classroom          Classroom?          @relation("ClassroomStudents", fields: [classroomId], references: [id])
  
  // Parent Link (for students)
  parentId           String?
  parent             User?               @relation("ParentToChildren", fields: [parentId], references: [id])
  children           User[]              @relation("ParentToChildren")
  
  // System Relations
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  activityLogs       ActivityLog[]
  courseProgresses   CourseProgress[]
  examSubmissions    ExamSubmission[]
  studentAnswers     StudentAnswer[]
  studentEnrollments StudentEnrollment[]
  teacherCourses     TeacherCourse[]
  managedClassrooms  Classroom[]         @relation("ClassroomTeacher")
  lessonProgresses   LessonProgress[]
  blockAnswers       BlockAnswer[]
  activityAttempts   ActivityAttempt[]
  xp                 Int                 @default(0)
  aiConversations    AiConversation[]
  aiInsight          StudentAiInsight?
  xpHistories        XPHistory[]
  sentMessages       Message[] @relation("MessageSender")
  receivedMessages   Message[] @relation("MessageRecipient")
  notifications      StudentNotification[]
  pushSubscriptions  PushSubscription[]
  certificates       Certificate[] @relation("CertificateRecipient")
  issuedCertificates Certificate[] @relation("CertificateIssuer")
  competitionProfile CompetitionProfile?
  hostedCompetitions Competition[]
  competitionEntries CompetitionEntry[]
  deletedAt          DateTime?           // Soft Delete: null = active, date = in trash
  
  // Content Creation Tracking
  createdCourses     Course[]            @relation("CourseCreator")
  createdExams       Exam[]              @relation("ExamCreator")
  createdLessons     Lesson[]            @relation("LessonCreator")
  createdExamFolders ExamFolder[]        @relation("ExamFolderCreator")
  createdSkillClusters SkillCluster[]    @relation("SkillClusterCreator")
  
  @@index([schoolId])
  @@index([role])
  @@index([grade])
}

model Classroom {
  id        String   @id @default(uuid())
  name      String   // e.g., "1/A", "Group 5"
  grade     String   // e.g., "الصف الأول الثانوي"
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  teacherId String?
  teacher   User?    @relation("ClassroomTeacher", fields: [teacherId], references: [id])
  
  students  User[]   @relation("ClassroomStudents")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String              @id @default(uuid())
  title       String
  description String?
  coverImage  String?
  grade       String?
  grades      String?
  subject     String?
  country     String              @default("مصر")
  isCentral   Boolean             @default(false)
  schoolId    String?
  creatorId   String?
  deletedAt   DateTime?           // Soft Delete: null = active, date = in trash (15-day recycle bin)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  school      School?             @relation("CourseOwner", fields: [schoolId], references: [id])
  creator     User?               @relation("CourseCreator", fields: [creatorId], references: [id])
  progresses  CourseProgress[]
  lessons     Lesson[]
  enrollments StudentEnrollment[]
  teachers    TeacherCourse[]
  exams       Exam[]
  schools     School[]            @relation("CourseToSchool")
  
  @@index([schoolId])
  @@index([isCentral])
  @@index([grade])
  @@index([subject])
  @@index([isCentral, grade])
  @@index([schoolId, grade])
  @@index([createdAt])
  @@index([deletedAt])
}

model StudentEnrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
}

model TeacherCourse {
  id        String   @id @default(uuid())
  teacherId String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, courseId])
  @@index([courseId])
}

model Lesson {
  id               String   @id @default(uuid())
  courseId         String
  title            String
  domain           String?
  content          String?
  videoUrl         String?
  summary          String?
  notes            String?
  questions        Json?    // Store JSON of questions
  attachments      Json?    // Store JSON of lesson resources (PDFs, PPTs, etc.)
  slides           Json?    // Store JSON of slides content
  assignments      Json?    // Store JSON of assignments content
  standards        String?  // Educational standards
  indicators       String?  // Learning indicators
  learningOutcomes String?  // Learning outcomes
  isCentral        Boolean   @default(false)
  isVisible        Boolean   @default(true)  // Show/hide from students
  publishDate      DateTime? // When the lesson becomes available
  cutOffDate       DateTime? // When the lesson is no longer accessible
  order            Int       @default(0)
  duration         Int       @default(0) // Duration in seconds
  deletedAt        DateTime? // Soft Delete: null = active, date = in trash (15-day recycle bin)
  originalCourseId String?   // Tracks original course before moving to النيل staging
  creatorId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator          User?     @relation("LessonCreator", fields: [creatorId], references: [id])
  progresses       LessonProgress[]
  blocks           LessonBlock[]
  aiGuidance       AiLessonGuidance?
  
  @@index([courseId, order])
  @@index([deletedAt])
  domainEn String?
  standardsEn String?
  indicatorsEn String?
  learningOutcomesEn String?
}

model LessonProgress {
  id              String   @id @default(uuid())
  userId          String
  lessonId        String
  watchedSeconds  Int      @default(0)
  activeStudySeconds Int   @default(0)
  lastActivityAt DateTime?
  isCompleted     Boolean  @default(false)
  lastBlockId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, isCompleted])
  @@index([lessonId])
}

model CourseProgress {
  id              String   @id @default(uuid())
  userId          String
  courseId        String
  progressPercent Float    @default(0)
  lastAccessedAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model ExamFolder {
  id          String   @id @default(uuid())
  title       String
  description String?
  grade       String?
  subject     String?
  schoolId    String?
  isCentral   Boolean  @default(false)
  creatorId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  exams       Exam[]
  school      School?  @relation(fields: [schoolId], references: [id])
  creator     User?    @relation("ExamFolderCreator", fields: [creatorId], references: [id])
}

model Exam {
  id                String           @id @default(uuid())
  title             String
  description       String?
  type              String           @default("Quiz")
  duration          Int              @default(30)
  passingScore      Int              @default(50)
  isCentral         Boolean          @default(false)
  showAnswers       Boolean          @default(true) 
  resultVisibility  String           @default("SHOW_SCORE") 
  password          String?
  startDate         DateTime?
  endDate           DateTime?
  attemptsAllowed   Int              @default(1)
  status            String           @default("PUBLISHED") 
  category          String?          
  grade             String?
  grades            String?
  subjects          String?
  schoolId          String?
  courseId          String?
  folderId          String?
  courseName        String?
  section           String?
  domain            String?
  learningOutcomes  String?
  indicators        String?
  skills            String?
  skill             String?
  gradeTarget       String?
  level             String           @default("Medium")
  creatorId         String?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  school            School?          @relation("ExamOwner", fields: [schoolId], references: [id])
  course            Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  folder            ExamFolder?      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  creator           User?            @relation("ExamCreator", fields: [creatorId], references: [id])
  modules           ExamModule[]
  submissions       ExamSubmission[]
  questions         Question[]
  schools           School[]         @relation("ExamToSchool")
  
  @@index([schoolId])
  @@index([isCentral])
  @@index([grade])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([schoolId, createdAt])
  @@index([isCentral, createdAt])
  @@index([folderId])
}

model Question {
  id              String          @id @default(uuid())
  examId          String
  text            String
  textEn          String?
  type            String          @default("MCQ")
  options         String
  optionsEn       String?
  correctAnswer   String
  points          Int             @default(1)
  xpPoints        Int             @default(10)
  skill           String?
  learningOutcome String?
  indicator       String?         // Unified metadata field
  videoUrl        String?         // Unified video field
  level           String          @default("Medium")
  dok             String?
  cognitive       String?
  course          String?
  section         String?
  domain          String?
  standard        String?
  subskill        String?
  microSkill      String?
  gradeTarget     String?
  errorPattern    String?
  estimatedTime   String?
  explanation     String?
  explanationEn   String?
  hint            String?
  hintEn          String?
  imageUrl        String?
  order           Int             @default(0)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  moduleId        String?
  subExamId       String?
  exam            Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  module          ExamModule?     @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  subExam         SubExam?        @relation(fields: [subExamId], references: [id], onDelete: SetNull)
  answers         StudentAnswer[]

  @@index([examId])
  @@index([examId, deletedAt])
  @@index([subExamId])
  @@index([subExamId, deletedAt])
  @@index([moduleId])
  @@index([deletedAt])
  courseEn String?
  sectionEn String?
  domainEn String?
  standardEn String?
  learningOutcomeEn String?
  indicatorEn String?
  skillEn String?
  subskillEn String?
  microSkillEn String?
  errorPatternEn String?
}

model ExamSubmission {
  id         String          @id @default(uuid())
  subExamId  String?
  userId     String
  examId     String
  totalScore Float
  totalTime  Int?
  createdAt  DateTime        @default(now())
  percentage Float?
  reportSnapshot Json?
  schoolIdAtSubmission String?
  gradeAtSubmission String?
  exam       Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    StudentAnswer[]
  
  @@index([userId])
  @@index([examId])
  @@index([userId, createdAt])
  @@index([examId, userId])
  @@index([schoolIdAtSubmission, createdAt])
}

model StudentAnswer {
  id             String         @id @default(uuid())
  submissionId   String
  userId         String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  questionSnapshot Json?
  timeTaken      Int?
  createdAt      DateTime       @default(now())
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission     ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  type      String
  metadata  String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LessonBlock {
  id              String            @id @default(uuid())
  lessonId        String
  type            String            // "TEXT" | "QUESTION"
  label           String?           // "CONTENT", "EXAMPLE", "SUMMARY", "MCQ", etc.
  title           String?           // Optional Card Name
  content         String?           // Main rich text or question text
  
  // Question specific fields
  options         String?           // Stored as JSON string
  correctAnswer   String?           // Stored as JSON or comma separated
  points          Int               @default(1)
  
  // Display settings
  order           Int               @default(0)
  isRequired      Boolean           @default(false)
  isVisible       Boolean           @default(true)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  lesson          Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sections        DynamicSection[]
  answers         BlockAnswer[]
  
  @@index([lessonId, order])
}

model DynamicSection {
  id              String            @id @default(uuid())
  blockId         String
  type            String            // "FEEDBACK", "HINT", "EXPLANATION", "TIP", "KEY_INSIGHT"
  content         String            // Rich text content
  order           Int               @default(0)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  block           LessonBlock       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  
  @@index([blockId, order])
}

model BlockAnswer {
  id              String            @id @default(uuid())
  userId          String
  blockId         String
  selectedAnswer  String            
  isCorrect       Boolean
  attempts        Int               @default(1)
  timeTaken       Int?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  block           LessonBlock       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  
  @@unique([userId, blockId])
  @@index([userId])
  @@index([blockId])
}

// 1. المحاور التعليمية الكبرى (الكلستر)
model SkillCluster {
  id          String         @id @default(uuid())
  name        String
  description String?
  subject     String
  grade       String
  isCentral   Boolean        @default(false)
  schoolId    String?
  schoolIds   String?        // JSON array of assigned school IDs; schoolId retains ownership
  creatorId   String?
  school      School?        @relation("SkillClusterOwner", fields: [schoolId], references: [id])
  creator     User?          @relation("SkillClusterCreator", fields: [creatorId], references: [id])
  skills      SkillLesson[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([schoolId])
  @@index([grade, subject])
}

// 2. المهارة الفرعية (الدرس المهاراتي)
model SkillLesson {
  id               String                @id @default(uuid())
  clusterId        String
  name             String
  description      String?
  order            Int                   @default(0)
  cluster          SkillCluster          @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  activities       InteractiveActivity[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

// 3. النشاط التفاعلي
model InteractiveActivity {
  id               String                @id @default(uuid())
  lessonId         String
  title            String
  titleEn          String?
  questionText     String?
  questionTextEn   String?
  type             String                // MCQ, MATCHING, DRAG_DROP, SORTING, CLOCK, MAZE...
  options          String                // JSON config
  optionsEn        String?               // JSON config for English
  correctAnswer    String                // JSON correct answer
  correctAnswerEn  String?               // JSON correct answer for English
  points           Int                   @default(10)
  xpPoints         Int                   @default(10)
  difficulty       String                @default("Medium") // Easy, Medium, Hard
  dok              String?               // Depth of Knowledge (1, 2, 3)
  estimatedTime    Int                   @default(60) // in seconds
  
  // Educational standards
  standard         String?
  indicator        String?
  learningOutcome  String?
  skill            String?
  
  // Educational elements
  hint             String?
  hintEn           String?
  tip              String?
  tipEn            String?
  explanation      String?
  explanationEn    String?
  keyInsight       String?
  keyInsightEn     String?
  
  lesson           SkillLesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts         ActivityAttempt[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  standardEn String?
  indicatorEn String?
  learningOutcomeEn String?
  skillEn String?
}

// 4. محاولات الطلاب وتقييمهم
model ActivityAttempt {
  id               String                @id @default(uuid())
  userId           String
  activityId       String
  selectedAnswer   String                // Student's answer
  isCorrect        Boolean
  score            Int                   // Points earned
  stars            Int                   // Stars (1-3)
  timeTaken        Int?                  // Time taken in seconds
  createdAt        DateTime              @default(now())
  
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity         InteractiveActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  
  @@index([userId, activityId])
}

model XPHistory {
  id          String   @id @default(uuid())
  userId      String
  xp          Int
  sourceType  String   // "EXAM", "LESSON_SLIDE", "LESSON_ASSIGNMENT", "LESSON_QUIZ", "INTERACTIVE_ACTIVITY"
  sourceId    String   // The ID of the exam, lesson, or interactive activity
  questionId  String   // The ID of the question (or block ID inside the lesson JSON)
  isCorrect   Boolean
  attemptNum  Int
  isBonus     Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, sourceId])
  @@index([userId, questionId])
}

// Stores explicit user-deletion markers so auto-recovery never re-creates deleted items
// even across Dokploy container re-deploys (unlike a local JSON file).
model DeletedTombstone {
  id          String   @id @default(uuid())
  entityType  String   // "lesson" or "course"
  entityId    String   // UUID of the deleted lesson or course
  entityTitle String?  // Human-readable title for debugging
  deletedAt   DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([entityType, entityId])
}

model ExamModule {
  id             String       @id @default(uuid())
  examId         String
  parentModuleId String?
  title          String
  description    String?
  order          Int          @default(0)
  duration       Int?
  passingScore   Int?
  gradeTarget    String?
  publishDate    DateTime?
  cutOffDate     DateTime?
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  parentModule   ExamModule?  @relation("ModuleHierarchy", fields: [parentModuleId], references: [id], onDelete: Cascade)
  subModules     ExamModule[] @relation("ModuleHierarchy")
  questions      Question[]
  subExams       SubExam[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  @@index([examId, order])
  @@index([parentModuleId])
  domain String?
  domainEn String?
  standards String?
  standardsEn String?
  indicators String?
  indicatorsEn String?
  learningOutcomes String?
  learningOutcomesEn String?
}

model SubExam {
  id            String      @id @default(uuid())
  moduleId      String
  title         String
  password      String?
  duration      Int?
  passingScore  Int?
  attemptsAllowed Int       @default(1)
  order         Int         @default(0)
  publishDate   DateTime?
  cutOffDate    DateTime?
  module        ExamModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions     Question[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@index([moduleId, order])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AiProvider {
  id              String   @id @default(uuid())
  parentId        String?
  parent          AiProvider? @relation("AiProviderKeys", fields: [parentId], references: [id], onDelete: Cascade)
  keys            AiProvider[] @relation("AiProviderKeys")
  name            String
  kind            String
  baseUrl         String
  model           String   @default("openai/gpt-oss-120b")
  encryptedKey    String
  keyFingerprint  String   @unique
  enabled         Boolean  @default(true)
  allowPublic     Boolean  @default(false)
  allowStudent    Boolean  @default(true)
  lastAssignedAt  DateTime @default(dbgenerated("'1970-01-01'::timestamp"))
  cooldownUntil   DateTime?
  requestCount    Int      @default(0)
  failureCount    Int      @default(0)
  lastStatus      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([enabled, lastAssignedAt])
  @@index([parentId])
}

model AiConversation {
  id        String @id @default(uuid())
  userId    String
  lessonId  String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  @@index([userId, updatedAt])
}

model AiMessage {
  id             String @id @default(uuid())
  conversationId String
  role           String
  content        String
  model          String?
  createdAt      DateTime @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model StudentAiInsight {
  userId      String @id
  evidence    Json
  narrative   String?
  fingerprint String
  generatedAt DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiLessonGuidance {
  lessonId       String @id
  enabled        Boolean @default(true)
  instructions   String @default("")
  referenceText  String @default("")
  starterPrompts Json?
  updatedAt      DateTime @updatedAt
  lesson         Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Message {
  id String @id @default(uuid())
  senderId String
  recipientId String
  body String
  createdAt DateTime @default(now())
  readAt DateTime?
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

// Private, authenticated student inbox; event keys make scheduler retries idempotent.
model StudentNotification {
  id String @id @default(uuid())
  userId String
  eventKey String
  kind String
  titleAr String
  titleEn String
  body String
  href String
  createdAt DateTime @default(now())
  readAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  @@unique([userId, eventKey])
  @@index([userId, createdAt])
}

model NotificationCursor {
  key String @id
  value DateTime
}

model PushSubscription {
  id String @id @default(uuid())
  userId String
  endpoint String @unique
  p256dh String
  auth String
  language String @default("ar")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  @@index([userId])
}

// Durable per-device outbox: outages do not lose notifications or duplicate inbox items.
model PushDelivery {
  id String @id @default(uuid())
  notificationId String
  subscriptionId String
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  deliveredAt DateTime?
  notification StudentNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@unique([notificationId, subscriptionId])
  @@index([deliveredAt, nextAttemptAt])
}

// File bytes stay inside the database and therefore inside every full snapshot.
// No certificate is exposed through public uploads or a bearer URL.
model Certificate {
  id String @id @default(uuid())
  schoolId String
  studentId String
  issuerId String
  title String
  message String?
  fileName String
  mimeType String
  byteSize Int
  sha256 String
  fileData String @db.Text
  createdAt DateTime @default(now())
  revokedAt DateTime?
  school School @relation(fields: [schoolId], references: [id])
  student User @relation("CertificateRecipient", fields: [studentId], references: [id])
  issuer User @relation("CertificateIssuer", fields: [issuerId], references: [id])
  @@index([studentId, createdAt])
  @@index([schoolId, createdAt])
}

model CompetitionPolicy {
  key String @id
  enabled Boolean @default(true)
  publicBoard Boolean @default(false)
  sound Boolean @default(true)
  motion Boolean @default(true)
  leaderboard Boolean @default(true)
}

model CompetitionProfile {
  userId String @id
  sound Boolean @default(true)
  motion Boolean @default(true)
  publicName Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Competition {
  id String @id @default(uuid())
  title String
  titleEn String?
  description String?
  descriptionEn String?
  schoolId String?
  creatorId String
  mode String @default("SELF_PACED")
  status String @default("DRAFT")
  grade String?
  subject String?
  scoringMode String @default("SPEED")
  sourceKind String @default("GENERAL")
  sourceId String?
  teams Boolean @default(false)
  capacity Int @default(200)
  publicBoard Boolean @default(false)
  prizeLabel String?
  prizePlaces Int @default(3)
  opensAt DateTime?
  closesAt DateTime?
  currentIndex Int @default(-1)
  questionStartedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school School? @relation(fields: [schoolId], references: [id])
  creator User @relation(fields: [creatorId], references: [id])
  questions CompetitionQuestion[]
  entries CompetitionEntry[]
  @@index([schoolId, status])
  @@index([sourceKind, sourceId])
}

model CompetitionQuestion {
  id String @id @default(uuid())
  competitionId String
  text String
  textEn String?
  options Json
  optionsEn Json?
  correctIndex Int @default(-1)
  type String @default("MCQ")
  points Int @default(100)
  correctAnswer Json?
  correctAnswerEn Json?
  metadata Json?
  seconds Int @default(30)
  order Int
  active Boolean @default(true)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  answers CompetitionAnswer[]
  @@unique([competitionId, order])
}

model CompetitionEntry {
  id String @id @default(uuid())
  competitionId String
  studentId String
  team Int @default(0)
  score Int @default(0)
  correct Int @default(0)
  currentIndex Int @default(0)
  questionStartedAt DateTime?
  questionSnapshot Json?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers CompetitionAnswer[]
  award CompetitionAward?
  @@unique([competitionId, studentId])
  @@index([competitionId, score])
  @@index([studentId, finishedAt])
}

model CompetitionAnswer {
  id String @id @default(uuid())
  entryId String
  questionId String
  selectedIndex Int?
  answer Json?
  correct Boolean
  points Int
  elapsedMs Int
  createdAt DateTime @default(now())
  entry CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  question CompetitionQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([entryId, questionId])
}

model CompetitionAward {
  id String @id @default(uuid())
  entryId String @unique
  rank Int
  title String
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  entry CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}
